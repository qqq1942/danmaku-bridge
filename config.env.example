# ═══════════ 弹幕桥接配置 ═══════════
# 改完这个文件后执行： ./run.sh restart
# ═══════════════════════════════════

# B站直播间号（必填）
ROOM_ID=23343237

# 每分钟最多转发多少条（防刷屏）
MAX_PER_MIN=12

# 游戏内显示的前缀
PREFIX=[弹幕]

# 最短/最长转发长度
MIN_LEN=1
MAX_LEN=50

# 屏蔽词（逗号分隔，命中不转发）
BLOCK_WORDS=

# B站登录 cookie（SESSDATA）。实测：匿名会过滤部分弹幕，建议填写
# 获取：浏览器登录B站 → F12 → Application → Cookies → SESSDATA
SESSDATA=

# ═══════════ 弹幕刷怪指令 ═══════════
# 需要服务端插件 DanmakuSpawn（~/terraria/danmaku-spawn），否则指令会被 TShock 回
# "Invalid command entered"，普通弹幕转发不受影响。

# 1=开启 0=关闭
CMD_ENABLE=1

# 指令前缀（! / # 以及全角 ！ 都认；观众最常打的是 /刷怪）
CMD_PREFIX=!

# 指令词，逗号分隔：!刷怪 / !spawn / !召唤 / !出怪
CMD_WORDS=刷怪,spawn,召唤,出怪

# 指定数量时最多几只（随机模式的数量由插件配置 RandomAmount 决定）
CMD_MAX_AMOUNT=5

# 不写数量时默认几只
CMD_DEFAULT_AMOUNT=1

# 全服每分钟最多几条刷怪指令
CMD_MAX_PER_MIN=6

# 同一观众冷却秒数
CMD_USER_COOLDOWN=30

# 最低舰长等级：0 不限 / 3 舰长 / 2 提督 / 1 总督
# 例：只给舰长及以上玩，填 3
CMD_MIN_GUARD=0

# 最低粉丝牌等级：0 不限
CMD_MIN_MEDAL=0

# 白名单观众（逗号分隔，填了就只有这些人能用；留空=所有人）
CMD_ALLOW=

# 黑名单观众（逗号分隔）
CMD_BLOCK=

# 没指定玩家时固定刷谁附近（留空=插件配置里的 DefaultTarget，默认随机在线玩家）
CMD_DEFAULT_PLAYER=
